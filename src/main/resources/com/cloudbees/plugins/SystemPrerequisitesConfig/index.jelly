<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">

  <f:form method="post" action="configSubmit" name="config">
    <f:section title="System Prerequisites">
      <f:section title="System Prerequisite Rules">

        <f:entry title="Description">
          <div>
            Define system-level prerequisite rules that run <strong>on the target node</strong>
            via Jenkins Remoting, <strong>before</strong> job-level prerequisites. Each rule can
            contain multiple execution scripts, and each script can target specific nodes via
            fuzzy pattern matching on the node name. Use node selection to further filter which
            nodes the rule applies to by labels or name regex.
          </div>
        </f:entry>

        <f:entry title="Retry Count" field="retryCount" help="/plugin/node-prerequisites/help-retryCount.html">
          <f:number field="retryCount" default="3" />
        </f:entry>

        <f:entry title="Retry Interval (seconds)" field="retryIntervalSeconds" help="/plugin/node-prerequisites/help-retryInterval.html">
          <f:number field="retryIntervalSeconds" default="30" />
        </f:entry>

        <f:entry title="Check Timeout (seconds)" field="checkTimeoutSeconds" help="/plugin/node-prerequisites/help-checkTimeout.html">
          <f:number field="checkTimeoutSeconds" default="60" />
        </f:entry>

        <f:entry title="Rules" field="rules">
          <f:repeatable var="rule" items="${it.rules}" noPre="0">
            <table width="100%" style="border: 1px solid #ccc; margin-bottom: 10px; padding: 5px;">
              <f:entry title="Rule Name" field="name">
                <f:textbox field="name" />
              </f:entry>

              <f:entry title="Node Selection" field="nodeSelectionMode">
                <select name="nodeSelectionMode">
                  <option value="all">All nodes</option>
                  <option value="labels">Match by labels</option>
                  <option value="regex">Match by name regex</option>
                </select>
              </f:entry>

              <f:entry title="Node Labels" field="nodeLabels" help="/plugin/node-prerequisites/help-nodeLabels.html">
                <f:textbox field="nodeLabels" />
              </f:entry>

              <f:entry title="Node Name Pattern (regex)" field="nodePattern" help="/plugin/node-prerequisites/help-nodePattern.html">
                <f:textbox field="nodePattern" />
              </f:entry>

              <f:entry title="Execution Scripts">
                <div>
                  Define one or more scripts to execute on matching nodes. Each script can
                  target specific nodes via fuzzy pattern matching (supports <code>*</code> and
                  <code>?</code> wildcards, comma-separated for multiple patterns).
                </div>
                <f:repeatable var="pscript" items="${rule.scripts}" field="scripts" noPre="0">
                  <table width="100%" style="border: 1px dashed #bbb; margin-top: 8px; padding: 4px;">
                    <f:entry title="Node Pattern (fuzzy)" field="nodePattern">
                      <f:textbox field="nodePattern" default="*" />
                    </f:entry>

                    <f:entry title="Interpreter" field="interpreter">
                      <select name="interpreter">
                        <option value="shell script">Shell Script</option>
                        <option value="windows batch command">Windows Batch Command</option>
                        <option value="groovy script">Groovy Script</option>
                      </select>
                    </f:entry>

                    <f:entry title="Groovy Sandbox" field="sandbox">
                      <f:checkbox field="sandbox" default="true" />
                    </f:entry>

                    <f:entry title="Script" field="script">
                      <f:textarea field="script" />
                    </f:entry>

                    <f:entry>
                      <div align="right">
                        <f:repeatableDeleteButton />
                      </div>
                    </f:entry>
                  </table>
                </f:repeatable>
              </f:entry>

              <f:entry>
                <div align="right">
                  <f:repeatableDeleteButton />
                </div>
              </f:entry>
            </table>
          </f:repeatable>
        </f:entry>

      </f:section>
    </f:section>
  </f:form>

</j:jelly>
