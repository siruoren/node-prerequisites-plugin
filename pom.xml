<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.jenkins-ci.plugins</groupId>
		<artifactId>plugin</artifactId>
		<version>4.18</version>
		<relativePath />
	</parent>

	<artifactId>node-prerequisites</artifactId>
	<version>1.2-SNAPSHOT</version>
	<packaging>hpi</packaging>

	<name>Node Prerequisites Plugin</name>
	<description>Run a script on a node before letting a Job run on it, to check for prerequisites. Supports environment variables like NODE_NAME, NODE_IP, NODE_HOSTNAME.</description>
	<url>https://github.com/jenkinsci/slave-prerequisites-plugin</url>
	<inceptionYear>2012</inceptionYear>

	<licenses>
		<license>
			<name>LGPL 3</name>
			<url>https://www.gnu.org/licenses/lgpl.html</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>ndeloof</id>
			<name>Nicolas De Loof</name>
			<email>nicolas.deloof@gmail.com</email>
		</developer>
	</developers>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<jenkins.version>2.277.4</jenkins.version>
		<java.level>8</java.level>
	</properties>

	<scm>
		<connection>scm:git:git://github.com/jenkinsci/slave-prerequisites-plugin.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/jenkinsci/slave-prerequisites-plugin.git</developerConnection>
		<url>https://github.com/jenkinsci/slave-prerequisites-plugin</url>
	</scm>

	<repositories>
		<repository>
			<id>repo.jenkins-ci.org</id>
			<url>https://repo.jenkins-ci.org/public/</url>
		</repository>
	</repositories>

	<pluginRepositories>
		<pluginRepository>
			<id>repo.jenkins-ci.org</id>
			<url>https://repo.jenkins-ci.org/public/</url>
		</pluginRepository>
	</pluginRepositories>

	<dependencyManagement>
		<dependencies>
			<!-- jenkins-core:2.277.4 pulls symbol-annotation:1.1, but structs:1.20 needs 1.20.
			     Pin to the upper bound (1.20) so requireUpperBoundDeps passes. -->
			<dependency>
				<groupId>org.jenkins-ci</groupId>
				<artifactId>symbol-annotation</artifactId>
				<version>1.20</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.jenkins-ci.plugins</groupId>
			<artifactId>matrix-project</artifactId>
			<version>1.18</version>
			<!-- Plugin-to-plugin dependencies must be 'compile' scope (not 'provided').
			     The maven-hpi-plugin's test-hpl goal rejects 'provided' plugin deps
			     ("should be the 'compile' scope"); compile scope records it in the
			     Plugin-Dependencies manifest and lets Jenkins resolve it at runtime
			     without bundling matrix-project's classes into WEB-INF/lib. -->
			<scope>compile</scope>
		</dependency>
		<dependency>
			<groupId>com.google.code.findbugs</groupId>
			<artifactId>jsr305</artifactId>
			<version>3.0.2</version>
			<scope>provided</scope>
		</dependency>
	</dependencies>

</project>
